#include <iostream>
#include <vector>
using namespace std;

// Radix Sort function
void radixSort(vector<int>& arr) {
    int maxVal = arr[0];
    for (int x : arr)
        if (x > maxVal)
            maxVal = x;

    int exp = 1;

    while (maxVal / exp > 0) {
        vector<vector<int>> buckets(10);

        for (int i = arr.size() - 1; i >= 0; i--) {
            int digit = (arr[i] / exp) % 10;
            buckets[digit].push_back(arr[i]);
        }

        arr.clear();

  
        for (int i = 0; i < 10; i++) {
            for (int j = buckets[i].size() - 1; j >= 0; j--) {
                arr.push_back(buckets[i][j]);
            }
        }

        exp *= 10;
    }
}

// Main function
int main() {
    vector<int> myArray = {170, 45, 75, 90, 802, 24, 2, 66};

    cout << "Original array: ";
    for (int x : myArray)
        cout << x << " ";

    radixSort(myArray);

    cout << "\nSorted array: ";
    for (int x : myArray)
        cout << x << " ";

    return 0;
}